# AI Quiz Generator Environment Configuration
PROJECT_NAME="AI Quiz Generator & Learning Platform"
API_V1_STR="/api"
SECRET_KEY="supersecretjwtkey_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite+aiosqlite:///./sql_app.db"

# LLM Provider Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
DEFAULT_MODEL="gemini-2.5-flash"

# Qdrant Vector DB (Local mode uses file path, server mode uses URL)
QDRANT_MODE="local"  # "local" or "server"
QDRANT_PATH="./qdrant_storage"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
